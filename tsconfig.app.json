{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"]
  },
  "include": ["src"],
  /* Код потока Worker проверяется в tsconfig.worker.json; SimulationBridge подключается через импорт */
  "exclude": ["src/simulation", "src/worker", "src/**/*.test.ts"]
}
